---
const naHome = Astro.url.pathname === "/";
---

<header class="header">
	<button type="button" class="header__menu-btn" data-i18n-aria="menu.abrir" aria-label="Abrir menu" aria-expanded="false" aria-controls="menu-lateral">
		<span class="header__menu-linhas" aria-hidden="true"></span>
	</button>
	<div class="header__fundo" aria-hidden="true"></div>
	<nav class="header__nav" id="menu-lateral">
		<a href="/" data-i18n="menu.inicio">Início</a>
		<a href="/trabalhos" data-i18n="cards.trabalhos">Trabalhos</a>
		<a href="/experimentos" data-i18n="cards.projetos">Experimentos</a>
		<a href="/sobre" data-i18n="menu.sobre">Sobre mim</a>
		<a href="/contato" data-i18n="menu.contato">Contato</a>

		<div class="header__idioma header__idioma--movel">
			<span class="header__idioma-label" data-i18n-slide="menu.idioma"
				><span class="header__idioma-clip">Idioma:</span></span
			>
			<button type="button" class="header__idioma-btn" data-i18n-aria="menu.trocar-idioma" aria-label="Mudar para inglês">
				<span class="header__idioma-label" data-i18n-slide="menu.idioma-atual"
					><span class="header__idioma-clip">Português</span></span
				>
			</button>
		</div>

		<div class="header__legal">
			<a href="/privacidade" data-i18n="footer.privacidade">Privacidade</a>
			<a href="/termos" data-i18n="footer.termos">Termos</a>
		</div>
	</nav>

	{naHome ? null : <a href="/" class="header__nome"><img src="/images/logo-frank.svg" alt="Frank Alves" /></a>}

	<div class="header__idioma">
		<span class="header__idioma-label" data-i18n-slide="menu.idioma"
			><span class="header__idioma-clip">Idioma:</span></span
		>
		<button type="button" class="header__idioma-btn" data-i18n-aria="menu.trocar-idioma" aria-label="Mudar para inglês">
			<span class="header__idioma-label" data-i18n-slide="menu.idioma-atual"
				><span class="header__idioma-clip">Português</span></span
			>
		</button>
	</div>
</header>

<style>
	.header {
		--altura-header: 56px;
		--borda-header: 1px solid var(--cor-borda);

		position: relative;
		z-index: 1;
		height: var(--altura-header);
		font-size: 11px;
		font-weight: 500;
		text-transform: uppercase;
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-bottom: var(--borda-header);
	}

	.header__nav,
	.header__idioma {
		display: flex;
		align-items: center;
	}

	.header__idioma--movel {
		display: none;
	}

	.header__nav {
		gap: 32px;
	}

	.header__idioma {
		gap: 12px;
	}

	.header__menu-btn,
	.header__fundo,
	.header__legal {
		display: none;
	}

	.header__nome::before {
		display: none;
	}

	.header__nome {
		position: absolute;
		left: 50%;
		transform: translateX(-50%);
		display: flex;
	}

	.header__nome img {
		display: block;
		height: 12.6px;
		width: auto;
	}

	.header a {
		color: inherit;
		text-decoration: none;
	}

	.header__idioma-label {
		position: relative;
	}

	.header__idioma-clip {
		position: relative;
		display: inline-block;
		overflow: hidden;
		white-space: nowrap;
		vertical-align: top;
	}

	.header__idioma-clip :global(span) {
		display: inline-block;
	}

	.header__idioma > .header__idioma-label::before {
		content: "";
		position: absolute;
		top: 100%;
		left: 0;
		width: 100%;
		height: 1px;
		background: currentColor;
		pointer-events: none;
		transform-origin: 100% 50%;
		transform: scale3d(0, 1, 1);
		transition: transform 0.3s;
	}

	.header__idioma:has(.header__idioma-btn:hover) > .header__idioma-label::before {
		transform-origin: 0% 50%;
		transform: scale3d(1, 1, 1);
	}

	.header__idioma-btn {
		padding: 0;
		border: 0;
		background: none;
		color: inherit;
		font: inherit;
		letter-spacing: inherit;
		text-transform: inherit;
		cursor: pointer;
	}

	@media (max-width: 768px) {
		.header__menu-btn {
			display: flex;
			align-items: center;
			justify-content: center;
			width: 32px;
			height: 32px;
			margin-left: -6px;
			padding: 0;
			border: 0;
			background: none;
			color: inherit;
			cursor: pointer;
			position: relative;
			z-index: 12;
			transition: transform 0.3s cubic-bezier(0.65, 0, 0.35, 1);
		}

		.header--aberto .header__menu-btn {
			transform: rotate(90deg);
		}

		.header__menu-linhas,
		.header__menu-linhas::before {
			display: block;
			width: 18px;
			height: 1.5px;
			background: currentColor;
		}

		.header__menu-linhas {
			position: relative;
			top: -3px;
		}

		.header__menu-linhas::before {
			content: "";
			position: absolute;
			top: 6px;
		}

		.header__menu-linhas,
		.header__menu-linhas::before {
			transition: transform 0.3s cubic-bezier(0.65, 0, 0.35, 1);
		}

		.header--aberto .header__menu-linhas {
			transform: translateY(3px) rotate(45deg);
		}

		.header--aberto .header__menu-linhas::before {
			transform: translateY(-6px) rotate(-90deg);
		}

		.header__fundo {
			display: block;
			position: fixed;
			inset: 0;
			z-index: 10;
			background: rgba(0, 0, 0, 0.35);
			opacity: 0;
			pointer-events: none;
			transition: opacity 0.3s;
		}

		.header__nav {
			position: fixed;
			top: 0;
			bottom: 0;
			left: 0;
			z-index: 11;
			width: min(80vw, 320px);
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			padding: 88px var(--padding-pagina) var(--padding-pagina);
			background: var(--cor-fundo-pagina);
			border-right: var(--borda-header);
			font-size: 14px;
			transform: translateX(-100%);
			visibility: hidden;
			transition:
				transform 0.3s cubic-bezier(0.65, 0, 0.35, 1),
				visibility 0s 0.3s;
		}

		.header__nav a {
			padding: 14px 0;
			border-bottom: 1px solid rgba(0, 0, 0, 0.15);
		}

		.header__nav a:first-child {
			border-top: 1px solid rgba(0, 0, 0, 0.15);
		}

		.header > .header__idioma {
			display: none;
		}

		.header__idioma--movel {
			display: flex;
			padding: 14px 0;
			border-bottom: 1px solid rgba(0, 0, 0, 0.15);
		}

		.header__legal {
			display: flex;
			flex-direction: column;
			gap: 16px;
			margin-top: auto;
			font-size: 11px;
		}

		.header--aberto .header__nav {
			transform: translateX(0);
			visibility: visible;
			transition:
				transform 0.3s cubic-bezier(0.65, 0, 0.35, 1),
				visibility 0s;
		}

		.header--aberto .header__fundo {
			opacity: 1;
			pointer-events: all;
		}

		.header__idioma > .header__idioma-label:first-child {
			display: none;
		}
	}
</style>

<script>
	import { traducoes, type Idioma } from "../i18n/translations";

	const CHAVE = "idioma";

	const slides = document.querySelectorAll<HTMLElement>("[data-i18n-slide]");

	function trocarTexto(clip: HTMLElement, novo: string, anterior?: string) {
		if (anterior === undefined || anterior === novo) {
			clip.textContent = novo;
			return;
		}

		const saindo = document.createElement("span");
		saindo.textContent = anterior;
		const entrando = document.createElement("span");
		entrando.textContent = novo;
		entrando.style.position = "absolute";
		entrando.style.left = "0";
		entrando.style.top = "0";
		clip.replaceChildren(saindo, entrando);

		const opcoes: KeyframeAnimationOptions = {
			duration: 300,
			easing: "cubic-bezier(0.5, 0.5, 0.3, 1)",
			fill: "forwards",
		};
		saindo.animate(
			[{ transform: "translate3d(0,0,0)" }, { transform: "translate3d(-150%,0,0)" }],
			opcoes,
		);
		entrando.animate(
			[{ transform: "translate3d(150%,0,0)" }, { transform: "translate3d(0,0,0)" }],
			opcoes,
		).onfinish = () => {
			clip.textContent = novo;
		};
	}

	function aplicar(idioma: Idioma, anterior?: Idioma) {
		document.documentElement.lang = idioma === "pt" ? "pt-BR" : "en";
		document.documentElement.dataset.idioma = idioma;
		const dict = traducoes[idioma];

		document.querySelectorAll<HTMLElement>("[data-i18n]").forEach((el) => {
			const texto = dict[el.dataset.i18n!];
			if (!texto) return;
			if (el.hasAttribute("data-i18n-html")) el.innerHTML = texto;
			else el.textContent = texto;
		});

		slides.forEach((label) => {
			const chave = label.dataset.i18nSlide!;
			const clip = label.querySelector<HTMLElement>(".header__idioma-clip")!;
			trocarTexto(clip, dict[chave], anterior && traducoes[anterior][chave]);
		});

		document.querySelectorAll<HTMLElement>("[data-i18n-aria]").forEach((el) => {
			const texto = dict[el.dataset.i18nAria!];
			if (texto) el.setAttribute("aria-label", texto);
		});

		try {
			localStorage.setItem(CHAVE, idioma);
		} catch {}
	}

	let atual: Idioma = "pt";
	try {
		if (localStorage.getItem(CHAVE) === "en") atual = "en";
	} catch {}

	aplicar(atual);

	document.querySelectorAll(".header__idioma-btn").forEach((btn) =>
		btn.addEventListener("click", () => {
			const anterior = atual;
			atual = atual === "pt" ? "en" : "pt";
			aplicar(atual, anterior);
		}),
	);
	const header = document.querySelector<HTMLElement>(".header")!;
	const botaoMenu = header.querySelector<HTMLButtonElement>(".header__menu-btn")!;

	function alternarMenu(abrir: boolean) {
		header.classList.toggle("header--aberto", abrir);
		botaoMenu.setAttribute("aria-expanded", String(abrir));
	}

	botaoMenu.addEventListener("click", () => alternarMenu(!header.classList.contains("header--aberto")));
	header.querySelector(".header__fundo")!.addEventListener("click", () => alternarMenu(false));
	header.querySelectorAll(".header__nav a").forEach((a) => a.addEventListener("click", () => alternarMenu(false)));
	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape") alternarMenu(false);
	});
	window.matchMedia("(min-width: 769px)").addEventListener("change", () => alternarMenu(false));
</script>
