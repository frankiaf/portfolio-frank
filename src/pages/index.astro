---
import Base from "../layouts/Base.astro";
---

<Base telaCheia>
	<h1 class="titulo"><span>Frank Alves</span></h1>
	<p class="descricao">
		<span class="descricao__destaque" data-i18n="hero.cargo">Designer gráfico</span>
		<span data-i18n="hero.local"> localizado em Santa Catarina, Brasil.</span><br />
		<span class="descricao__resumo" data-i18n="hero.resumo" data-i18n-html>Especialista em design de <em>embalagens</em> e <em>produtos</em>, com
experiência em produção gráfica e arte final.</span>
	</p>

	<section class="cards">
		<div class="card">
			<h2 class="card__titulo" data-i18n="cards.trabalhos">Trabalhos</h2>
			<a href="/trabalhos" class="card__midia"><img src="/images/trabalhos.png" alt="Produtos noorskin" /></a>
		</div>
		<div class="card">
			<h2 class="card__titulo" data-i18n="cards.projetos">Experimentos</h2>
			<a href="/experimentos" class="card__midia"><img src="/images/projetos-pessoais.png" alt="Caderno com esboços de embalagens, moodboard e amostras de materiais" /></a>
		</div>
		<div class="card">
			<h2 class="card__titulo" data-i18n="cards.sobre">Sobre mim</h2>
			<a href="/sobre" class="card__midia"><img src="/images/sobre-mim.png" alt="Frank de braços cruzados, olhando para o lado" /></a>
		</div>
	</section>

	<div class="cursor" aria-hidden="true"></div>
</Base>

<script>
	const titulo = document.querySelector<HTMLElement>(".titulo")!;
	const texto = titulo.querySelector<HTMLElement>("span")!;

	const ctx = document.createElement("canvas").getContext("2d")!;

	function ajustar() {
		const conteudo = texto.textContent!.toUpperCase();
		const base = 100;
		ctx.font = `500 ${base}px "General Sans"`;
		const m = ctx.measureText(conteudo);
		const espacamento = -0.02 * base;
		const tintaBase = m.actualBoundingBoxLeft + m.actualBoundingBoxRight + (conteudo.length - 1) * espacamento;
		const tamanho = (titulo.clientWidth / tintaBase) * base;

		titulo.style.fontSize = `${tamanho}px`;
		texto.style.marginLeft = `${(m.actualBoundingBoxLeft * tamanho) / base}px`;
	}

	document.fonts.ready.then(ajustar);
	new ResizeObserver(ajustar).observe(titulo);

	// Revelação em cascata: título -> descrição -> cards, um depois do outro.
	const reduzir = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
	if (!reduzir) {
		document.fonts.ready.then(() => {
			requestAnimationFrame(() => requestAnimationFrame(() => {
				document.documentElement.classList.add("pronto");
			}));
		});
	}

	// Cursor customizado: só em telas com mouse de verdade.
	if (!reduzir && window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
		const cursor = document.querySelector<HTMLElement>(".cursor")!;
		let x = 0;
		let y = 0;
		let mostrado = false;

		window.addEventListener("mousemove", (e) => {
			x = e.clientX;
			y = e.clientY;
			cursor.style.transform = `translate3d(${x}px, ${y}px, 0)`;
			if (!mostrado) {
				cursor.classList.add("cursor--visivel");
				mostrado = true;
			}
		});

		document.querySelectorAll<HTMLElement>(".card__midia").forEach((midia) => {
			midia.addEventListener("mouseenter", () => cursor.classList.add("cursor--grande"));
			midia.addEventListener("mouseleave", () => cursor.classList.remove("cursor--grande"));
		});
	}
</script>

<style is:global>
	.titulo {
		font-size: 200px;
		font-weight: 500;
		line-height: 1;
		letter-spacing: -0.02em;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.titulo span {
		display: inline-block;
	}

	.descricao {
		margin-top: clamp(8px, 2.5vh, 24px);
		font-family: var(--fonte-serifada);
		font-size: clamp(14px, 2.2vh, 20px);
		max-width: 640px;
		line-height: 1.5;
	}

	.descricao__resumo {
		white-space: pre-line;
	}

	.descricao__destaque,
	.descricao__resumo em {
		font-family: "Source Serif 4", var(--fonte-serifada);
		font-style: italic;
	}

	.cards {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 20px;
		flex: 1;
		min-height: 0;
		margin-top: clamp(16px, 5vh, 48px);
		padding-bottom: 34px;
	}

	.card {
		display: flex;
		flex-direction: column;
		min-height: 0;
	}

	.card__titulo {
		position: relative;
		width: fit-content;
		cursor: default;
		margin-bottom: 16px;
		font-size: 11px;
		font-weight: 500;
		text-transform: uppercase;
	}

	.card__titulo::before {
		content: "";
		position: absolute;
		top: 100%;
		left: 0;
		width: 100%;
		height: 1px;
		background: currentColor;
		pointer-events: none;
		transform-origin: 100% 50%;
		transform: scale3d(0, 1, 1);
		transition: transform 0.3s;
	}

	.card:has(a:hover) .card__titulo::before {
		transform-origin: 0% 50%;
		transform: scale3d(1, 1, 1);
	}

	.card__midia {
		position: relative;
		display: block;
		flex: 1;
		min-height: 0;
		overflow: hidden;
	}

	.card img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s cubic-bezier(0.25, 0.8, 0.25, 1);
	}

	.card:has(a:hover) img {
		transform: scale(1.06);
	}

	/* Cursor customizado */
	.cursor {
		position: fixed;
		top: 0;
		left: 0;
		width: 10px;
		height: 10px;
		margin: -5px 0 0 -5px;
		border-radius: 50%;
		background: var(--cor-texto);
		border: 1px solid var(--cor-fundo-pagina);
		box-sizing: border-box;
		pointer-events: none;
		z-index: 30;
		opacity: 0;
		transition:
			width 0.25s cubic-bezier(0.25, 0.8, 0.25, 1),
			height 0.25s cubic-bezier(0.25, 0.8, 0.25, 1),
			margin 0.25s cubic-bezier(0.25, 0.8, 0.25, 1),
			opacity 0.25s;
	}

	.cursor--visivel {
		opacity: 1;
	}

	.cursor--grande {
		width: 48px;
		height: 48px;
		margin: -24px 0 0 -24px;
		background: transparent;
		border: 1.5px solid var(--cor-texto);
	}

	/* Revelação em cascata */
	.titulo,
	.descricao,
	.cards .card {
		opacity: 0;
		transform: translateY(16px);
		transition:
			opacity 0.6s ease,
			transform 0.6s ease;
	}

	html.pronto .titulo {
		opacity: 1;
		transform: none;
	}

	html.pronto .descricao {
		opacity: 1;
		transform: none;
		transition-delay: 0.12s;
	}

	html.pronto .cards .card:nth-child(1) {
		opacity: 1;
		transform: none;
		transition-delay: 0.24s;
	}

	html.pronto .cards .card:nth-child(2) {
		opacity: 1;
		transform: none;
		transition-delay: 0.32s;
	}

	html.pronto .cards .card:nth-child(3) {
		opacity: 1;
		transform: none;
		transition-delay: 0.4s;
	}

	@media (prefers-reduced-motion: reduce) {
		.titulo,
		.descricao,
		.cards .card {
			opacity: 1;
			transform: none;
			transition: none;
		}

		.card img {
			transition: none;
		}
	}

	@media (max-width: 768px) {
		.titulo {
			margin-top: 26px; /* com o respiro interno da fonte, ~34px visíveis, igual ao espaço sobre o footer */
		}

		/* texto corrido: sem as quebras de linha manuais */
		.descricao br {
			display: none;
		}

		.descricao__resumo {
			white-space: normal;
		}

		.descricao__resumo::before {
			content: " ";
		}
	}
</style>
