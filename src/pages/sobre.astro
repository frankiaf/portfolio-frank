---
import Base from "../layouts/Base.astro";
import Voltar from "../components/Voltar.astro";
---

<Base titulo="Sobre mim | Frank Alves" telaCheia>
	<div class="voltar-topo">
		<Voltar />
	</div>

	<section class="sobre">
		<div class="sobre__foto">
			<img src="/images/sobre-mim.png" alt="Frank de braços cruzados, olhando para o lado" />
		</div>

		<div class="sobre__texto">
			<h1 class="sobre__titulo" data-i18n="sobre.titulo">
				Frank atuou como diretor de arte no redesign de grandes marcas
			</h1>

			<div class="sobre__corpo">
				<div class="sobre__info">
					<p>Frank Alves</p>
					<p>Florianópolis, SC</p>
				</div>

				<div class="sobre__bio">
					<p data-i18n="sobre.p1">Me chamo Frank Alves, sou designer gráfico e moro em Florianópolis, Santa Catarina.</p>
					<p data-i18n="sobre.p2">
						Estudei design e trabalho com identidade visual, ilustração e peças gráficas para marcas que querem se diferenciar.
						Aqui vai a sua história, do jeito que você quiser contar.
					</p>
					<p data-i18n="sobre.p3">Cada projeto é pensado sob medida, cuidando de cada detalhe do começo ao fim.</p>
				</div>
			</div>

			<div class="sobre__formacao">
				<ul class="sobre__lista">
					<li>
						<span class="sobre__curso">Graduação</span>
						<span class="sobre__detalhe">Design Gráfico</span>
					</li>
					<li>
						<span class="sobre__curso">Pós-graduação</span>
						<span class="sobre__detalhe">UX Design</span>
					</li>
					<li>
						<span class="sobre__curso">Pós-graduação</span>
						<span class="sobre__detalhe">Design de Produto e Engenharia de Embalagens</span>
					</li>
					<li>
						<span class="sobre__curso">Tecnólogo</span>
						<span class="sobre__detalhe">Análise e Desenvolvimento de Sistemas (ADS)</span>
					</li>
				</ul>
			</div>
		</div>
	</section>
</Base>

<style>
	.voltar-topo {
		flex-shrink: 0;
		margin-top: 40px;
	}

	.sobre {
		flex: 1;
		min-height: 0;
		display: grid;
		grid-template-columns: 32.4% 1fr;
		column-gap: 11.35%;
		align-items: start;
		padding: 32px 0 40px;
		overflow-y: auto;
		scrollbar-width: none;
	}

	.sobre::-webkit-scrollbar {
		display: none;
	}

	.sobre__foto img {
		display: block;
		width: 100%;
		aspect-ratio: 453 / 356;
		object-fit: cover;
	}

	.sobre__titulo {
		margin-left: 257px;
		font-size: 48px;
		font-weight: 500;
		line-height: 1.15;
		letter-spacing: -0.01em;
		text-transform: uppercase;
	}

	.sobre__corpo {
		display: grid;
		grid-template-columns: 257px minmax(0, 555px);
	}

	.sobre__corpo {
		margin-top: 56px;
	}

	.sobre__info {
		font-size: 16px;
		line-height: 1.3;
	}

	.sobre__bio {
		font-family: var(--fonte-serifada);
		font-size: 16px;
		line-height: 1.3;
	}

	.sobre__bio p + p {
		margin-top: 1.3em;
	}

	.sobre__formacao {
		display: grid;
		grid-template-columns: 257px minmax(0, 555px);
		margin-top: 56px;
	}

	.sobre__lista {
		grid-column: 2;
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid rgba(0, 0, 0, 0.15);
	}

	.sobre__lista li {
		display: flex;
		flex-direction: column;
		gap: 4px;
		padding: 14px 0;
		border-bottom: 1px solid rgba(0, 0, 0, 0.15);
	}

	.sobre__curso {
		font-size: 10px;
		text-transform: uppercase;
	}

	.sobre__detalhe {
		font-family: var(--fonte-serifada);
		font-size: 16px;
		line-height: 1.3;
	}

	@media (max-width: 768px) {
		.sobre {
			display: flex;
			flex-direction: column;
			padding: 20px 0 40px;
		}

		.sobre__titulo {
			margin-left: 0;
			margin-top: 24px;
			font-size: 28px;
		}

		.sobre__corpo {
			display: block;
			margin-top: 24px;
		}

		.sobre__info {
			display: none;
		}

		.sobre__formacao {
			display: block;
			margin-top: 32px;
		}

		.sobre__lista {
			grid-column: auto;
		}
	}
</style>
